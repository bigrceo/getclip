# Public site URL (metadata, OG, createdOn)
NEXT_PUBLIC_SITE_URL=http://localhost:4082

# Solana: paid RPC (Helius). Websocket used by the indexer worker.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_PUBLIC_KEY

# Platform keypair (base58 secret key). Pays ~0.006 SOL per launch and co-signs every create tx.
PLATFORM_SECRET_KEY=

# Postgres (Neon). Leave empty to run on demo data.
DATABASE_URL=

# Metadata to IPFS: pump.fun's endpoint is used by default; set Pinata to use it instead.
PINATA_JWT=

# Media storage for stills / loops (Vercel Blob). Empty = local .data/ folder (dev only).
BLOB_READ_WRITE_TOKEN=

# Limits
LAUNCHES_PER_IP_PER_DAY=5
MAX_FIRST_BUY_SOL=5
# Set to 1 to block real launches (sends nothing). Default on until you flip it.
LAUNCH_DRY_RUN=1
