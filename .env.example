# Public site URL (metadata, OG, createdOn)
NEXT_PUBLIC_SITE_URL=http://localhost:4082

# Solana: paid RPC (Helius). Websocket used by the indexer worker.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_PUBLIC_KEY

# Platform keypair (base58 secret key). Pays ~0.006 SOL per launch and co-signs every create tx.
PLATFORM_SECRET_KEY=

# Postgres. Neon URL (*.neon.tech) or any postgres:// URL (local: `npm run db:local` → postgres://postgres@127.0.0.1:5439/postgres).
# Leave empty to run on demo data.
DATABASE_URL=

# AES-256-GCM key for mint_pool secrets at rest (32 bytes, base64 or hex): `openssl rand -base64 32`.
# Grinder encrypts with it, launch decrypts. Old plaintext rows still work.
MINT_POOL_KEY=

# Metadata to IPFS: pump.fun's endpoint is used by default (often returns 500: set Pinata for mainnet).
# On devnet (SOLANA_RPC_URL contains "devnet") metadata falls back to being served from /api/meta/<id>.
PINATA_JWT=

# Media storage for stills / loops (Vercel Blob). Empty = local .data/ folder (dev only).
BLOB_READ_WRITE_TOKEN=

# Limits
LAUNCHES_PER_IP_PER_DAY=5
MAX_FIRST_BUY_SOL=5
# Set to 1 to block real launches (sends nothing). Default on until you flip it.
LAUNCH_DRY_RUN=1

# Google Maps Platform key with the Map Tiles API enabled: turns the hero into photoreal Miami (Google 3D Tiles). Empty = Leonida fan map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
